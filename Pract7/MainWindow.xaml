<Window x:Class="Pract7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pract7"
        mc:Ignorable="d"
        Title="Fura" Height="600" Width="1000"
        Background="LightGray">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox Width="150" Margin="5" 
                     Text="{Binding FilterMaterial, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="100" Margin="5" 
                     Text="{Binding FilterMaxPrice, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Найти" Click="LoadClick" Margin="5"
                     />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  MouseDoubleClick="ListDoubleClick" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn  Width="40" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn  Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Width="120" DisplayMemberBinding="{Binding Material}" />
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding Price}" />
                    <GridViewColumn Width="60" DisplayMemberBinding="{Binding Quantity}" />
                    <GridViewColumn  Width="70" DisplayMemberBinding="{Binding IsAvailable}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="Создать" Click="CreateClick" Margin="5"
                        />
                <Button Content="Изменить" Click="EditClick" Margin="5"
                        />
                <Button Content="Удалить" Click="DeleteClick" Margin="5"
                        />
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
