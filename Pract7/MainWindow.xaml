<Window x:Class="Pract7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pract7"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Furniture Client" Height="600" Width="1000"
        Background="#eeeeee">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="150" Margin="0,0,5,0" materialDesign:HintAssist.Hint="material"
                     Text="{Binding FilterMaterial, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="100" Margin="0,0,5,0" materialDesign:HintAssist.Hint="maxPrice"
                     Text="{Binding FilterMaxPrice, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Найти" Click="LoadClick" Margin="0,0,5,0"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" Width="40" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="Название" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Материал" Width="120" DisplayMemberBinding="{Binding Material}" />
                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Price}" />
                    <GridViewColumn Header="Кол-во" Width="60" DisplayMemberBinding="{Binding Quantity}" />
                    <GridViewColumn Header="Наличие" Width="70" DisplayMemberBinding="{Binding IsAvailable}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Width="180" Margin="0,0,5,0" materialDesign:HintAssist.Hint="Название"
                         Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="120" Margin="0,0,5,0" materialDesign:HintAssist.Hint="Материал"
                         Text="{Binding SelectedItem.Material, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="80" Margin="0,0,5,0" materialDesign:HintAssist.Hint="Цена"
                         Text="{Binding SelectedItem.Price, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="70" Margin="0,0,5,0" materialDesign:HintAssist.Hint="Количество"
                         Text="{Binding SelectedItem.Quantity, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="В наличии" VerticalAlignment="Center" Margin="0,0,10,0"
                          IsChecked="{Binding SelectedItem.IsAvailable}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Создать" Click="CreateClick" Margin="0,0,5,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Сохранить" Click="SaveClick" Margin="0,0,5,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="PATCH" Click="PatchClick" Margin="0,0,5,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Удалить" Click="DeleteClick" Margin="0,0,5,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>