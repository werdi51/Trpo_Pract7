<Window x:Class="Pract7.CreateOrEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="что0то"
        Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="LightGray">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название" VerticalAlignment="Center" Margin="12" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                 Text="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Text="Материал" VerticalAlignment="Center" Margin="12" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                 Text="{Binding Item.Material, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Text="Цена" VerticalAlignment="Center" Margin="12" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                 Text="{Binding Item.Price, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Text="Количество" VerticalAlignment="Center" Margin="12" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                 Text="{Binding Item.Quantity, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Grid.Row="4" Grid.Column="1" Content="В наличии" Margin="12"
                  IsChecked="{Binding Item.IsAvailable}" />

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Status}"
                   Foreground="#c62828" TextWrapping="Wrap" VerticalAlignment="Bottom"
                   Margin="8" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Сохранить" Click="SaveClick" Margin="8"
                    />
            <Button Content="PATCH" Click="PatchClick" Margin="8"
                    Visibility="{Binding PatchVisibility}"
                     />
            <Button Content="Отмена" IsCancel="True"
                     />
        </StackPanel>
    </Grid>
</Window>
